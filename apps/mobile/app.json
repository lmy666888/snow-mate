{
  "expo": {
    "name": "Snowmate",
    "slug": "snowmate",
    "scheme": "snowmate",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.snowmate.app"
    },
    "android": {
      "package": "com.snowmate.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Snowmate"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos to save privately on this device. Snowmate does not upload them.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
